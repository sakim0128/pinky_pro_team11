<?xml version="1.0"?>
<!--
  상부(천장) 카메라 ArUco 추적 — 관제 PC(도메인 8) 에서 띄운다.

    ros2 launch pinky_fleet_station overhead_tracker.launch.xml                       # 웹캠 /dev/video0 + 추적기
    ros2 launch pinky_fleet_station overhead_tracker.launch.xml camera_device:=2      # 다른 웹캠
    ros2 launch pinky_fleet_station overhead_tracker.launch.xml use_camera:=False     # 영상이 다른 곳(relay 영상 공유 등)에서 올 때

  overhead_camera_node 가 image_topic 으로 JPEG 을 내고, overhead_tracker_node 가 그 토픽을 구독해
  /pinky1/overhead_pose · /pinky2/overhead_pose 를 낸다 (config/overhead_tracker.yaml, 호모그래피가 비면 발행 안 함).
-->
<launch>
  <arg name="params" default="$(find-pkg-share pinky_fleet_station)/config/overhead_tracker.yaml"/>
  <arg name="image_topic" default="/overhead/camera/image/compressed"
       description="웹캠 노드가 내는 토픽. overhead_tracker.yaml 의 image_topic 과 같아야 한다"/>
  <arg name="use_camera" default="True" description="True: overhead_camera_node(웹캠) 를 같이 띄운다"/>
  <arg name="camera_device" default="0" description="cv2.VideoCapture 장치: 정수(/dev/video&lt;N&gt;) 또는 경로"/>
  <arg name="camera_width" default="1280"/>
  <arg name="camera_height" default="720"/>
  <arg name="camera_fps" default="15.0"/>
  <arg name="camera_jpeg_quality" default="80"/>

  <!-- 웹캠이 다른 프로세스에 잡혀 있으면 노드 안에서 재시도한다. 그래도 죽으면 3 초 뒤 다시 띄운다 -->
  <node pkg="pinky_fleet_station" exec="overhead_camera_node" name="overhead_camera" output="screen"
        if="$(var use_camera)" respawn="true" respawn_delay="3.0">
    <param name="device" value="$(var camera_device)"/>
    <param name="width" value="$(var camera_width)"/>
    <param name="height" value="$(var camera_height)"/>
    <param name="fps" value="$(var camera_fps)"/>
    <param name="jpeg_quality" value="$(var camera_jpeg_quality)"/>
    <param name="topic" value="$(var image_topic)"/>
  </node>

  <node pkg="pinky_fleet_station" exec="overhead_tracker_node" name="overhead_tracker" output="screen">
    <param from="$(var params)"/>
  </node>
</launch>
