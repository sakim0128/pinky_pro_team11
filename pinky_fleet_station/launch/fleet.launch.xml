<?xml version="1.0"?>
<!--
  관제 PC 최상위 launch.

    export ROS_DOMAIN_ID=0
    ros2 launch pinky_fleet_station fleet.launch.xml \
        mission:=$HOME/fleet_ws/src/pinky_pro_team11/pinky_fleet_station/config/mission.yaml

  domain_bridge + coordinator + GUI 를 한 번에 띄운다.
  로봇 2대를 먼저 띄운 뒤 실행할 것 (브리지의 QoS 매칭이 안정적이다).
-->
<launch>
    <arg name="mission"
         default="$(find-pkg-share pinky_fleet_station)/config/mission.yaml"/>
    <arg name="bridge_config"
         default="$(find-pkg-share pinky_fleet_station)/config/bridge_fleet.yaml"/>
    <arg name="use_bridge" default="True"
         description="가짜 로봇(fake_state_pub)으로 검증할 때는 False 로 둔다."/>
    <arg name="use_gui" default="True"/>

    <include file="$(find-pkg-share pinky_fleet_station)/launch/bridges.launch.xml"
             if="$(var use_bridge)">
        <arg name="bridge_config" value="$(var bridge_config)"/>
    </include>

    <node pkg="pinky_fleet_station" exec="coordinator_node" name="fleet_coordinator"
          output="screen">
        <param name="mission" value="$(var mission)"/>
    </node>

    <node pkg="pinky_fleet_station" exec="gui_node" name="fleet_gui"
          output="screen" if="$(var use_gui)">
        <param name="mission" value="$(var mission)"/>
    </node>
</launch>
