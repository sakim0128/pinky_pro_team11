<?xml version="1.0"?>
<!--
  실기 없이 차선 주행 전체(경로·예약·인식·FSM)를 검증한다. 관제 도메인에 가짜 로봇 2대를
  띄우므로 브릿지가 필요 없다. ** 실제 핑키는 움직이지 않는다. **

    export ROS_DOMAIN_ID=0
    ros2 launch pinky_lane_station fake_lane.launch.xml auto_start:=True

  확인:  ros2 topic echo /fleet/lane/status
         ros2 run rqt_image_view rqt_image_view /pinky1/lane_debug/compressed
  시나리오 2(교차로 만남)는 lane_mission.yaml 의 start/goal 을 바꾸거나 control 토픽으로 assign.
  장애물:  obstacle:="[0.3, -0.45, 0.05]"  (map x, y, 반지름) — 그 앞에서 OBSTACLE_WAIT 확인
  위치:    기본은 가짜 로봇이 odom 드리프트를 넣고, 항공뷰 흉내(참값+잡음, 관제 시계) 10 Hz + 합성 바닥 마커
           (파이프라인 → PoseFix, 로봇 시계) 두 소스를 가짜 로봇 안의 PoseFuser 로 합친다.
           fake_overhead_rate:=0 이면 바닥 마커만.
           use_amcl:=True 면 참값 pose 를 그대로 쓴다 (마커 없음).
-->
<launch>
    <arg name="mission" default="$(find-pkg-share pinky_lane_station)/config/lane_mission.yaml"/>
    <arg name="detector_config"
         default="$(find-pkg-share pinky_lane_station)/config/detector_lane.yaml"/>
    <arg name="use_amcl" default="False" description="True 면 마커 PoseFix 를 내지 않는다 (로봇이 AMCL)"/>
    <arg name="markers_config" default="$(find-pkg-share pinky_lane_station)/config/markers.yaml"/>
    <arg name="camera_intrinsics" default="$(find-pkg-share pinky_lane_station)/config/camera_intrinsics.yaml"/>
    <arg name="camera_extrinsics" default="$(find-pkg-share pinky_lane_station)/config/camera_extrinsics.yaml"/>
    <arg name="auto_start" default="False"/>
    <arg name="obstacle" default="[0.0, 0.0, 0.0]"/>
    <arg name="fake_overhead_rate" default="10.0"
         description="항공뷰 흉내(참값+잡음 PoseFix, 관제 시계) 주기. 0 이면 바닥 마커만"/>
    <arg name="odom_drift_v" default="0.02" description="가짜 odom 속도 배율 오차 (0.02 = 2 %)"/>
    <arg name="odom_drift_w" default="0.02" description="가짜 odom 요 드리프트 (rad/s, 주행 중)"/>
    <arg name="loopback" default="False"
         description="True 면 파이프라인을 거치지 않고 가짜 로봇 안에서 LanePath 를 만든다"/>

    <node pkg="pinky_lane_station" exec="fake_lane_robot" name="fake_lane_robot" output="screen">
        <param name="mission" value="$(var mission)"/>
        <param name="obstacle" value="$(var obstacle)"/>
        <param name="loopback" value="$(var loopback)"/>
        <param name="use_amcl" value="$(var use_amcl)"/>
        <param name="markers_config" value="$(var markers_config)"/>
        <param name="odom_drift_v" value="$(var odom_drift_v)"/>
        <param name="odom_drift_w" value="$(var odom_drift_w)"/>
        <param name="fake_overhead_rate" value="$(var fake_overhead_rate)"/>
    </node>

    <node pkg="pinky_lane_station" exec="lane_coordinator_node" name="lane_coordinator"
          output="screen">
        <param name="mission" value="$(var mission)"/>
        <param name="auto_start" value="$(var auto_start)"/>
    </node>

    <node pkg="pinky_lane_station" exec="lane_pipeline_node" name="lane_pipeline" output="screen"
          unless="$(var loopback)">
        <param name="mission" value="$(var mission)"/>
        <param name="detector_config" value="$(var detector_config)"/>
        <param name="markers_config" value="$(var markers_config)" unless="$(var use_amcl)"/>
        <param name="camera_intrinsics" value="$(var camera_intrinsics)" unless="$(var use_amcl)"/>
        <param name="camera_extrinsics" value="$(var camera_extrinsics)" unless="$(var use_amcl)"/>
        <param name="publish_debug_image" value="True"/>
    </node>
</launch>
