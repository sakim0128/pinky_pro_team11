<?xml version="1.0"?>
<!--
  domain_bridge 4 프로세스 — 로봇마다 업링크(로봇→관제)·다운링크(관제→로봇) 하나씩. 도메인 번호는 **인수**다:

    ros2 launch pinky_lane_station lane_bridge.launch.xml station_domain:=0 pinky1_domain:=45 pinky2_domain:=46

  yaml(config/bridge_pinkyN_{up,down}.yaml) 에는 토픽·QoS 만 있고 도메인이 없다 — bridge_runner 가 from·to 도메인 인수로 채운 사본을
  만들어 domain_bridge 에 넘긴다 (apt 의 domain_bridge 는 yaml 에 from_domain 이 없으면 명령줄 인수를 주어도 죽는다, 2026-09-30 실측).
  영상(업링크)과 명령(다운링크)을 프로세스로 나눠 영상이 명령 큐를 밀어내지 않게 한다.
    sudo apt install ros-jazzy-domain-bridge
  관제 PC 에 pinky_fleet_msgs · pinky_lane_msgs 가 빌드/소싱되어 있어야 한다.
  state/command 만 쓰는 mini_project_1 스택은 pinky_fleet_station/launch/bridges.launch.xml(bridge_fleet.yaml) 을 쓴다 — 같이 띄우지 않는다.
-->
<launch>
    <arg name="station_domain" default="$(env ROS_DOMAIN_ID 0)" description="관제 PC 도메인 (기본: 지금 셸의 ROS_DOMAIN_ID)"/>
    <arg name="pinky1_domain" default="10"/>
    <arg name="pinky2_domain" default="11"/>
    <arg name="config_dir" default="$(find-pkg-share pinky_lane_station)/config"/>

    <node pkg="pinky_lane_station" exec="bridge_runner" name="pinky1_bridge_up" output="screen"
          args="--from $(var pinky1_domain) --to $(var station_domain) $(var config_dir)/bridge_pinky1_up.yaml"/>
    <node pkg="pinky_lane_station" exec="bridge_runner" name="pinky1_bridge_down" output="screen"
          args="--from $(var station_domain) --to $(var pinky1_domain) $(var config_dir)/bridge_pinky1_down.yaml"/>
    <node pkg="pinky_lane_station" exec="bridge_runner" name="pinky2_bridge_up" output="screen"
          args="--from $(var pinky2_domain) --to $(var station_domain) $(var config_dir)/bridge_pinky2_up.yaml"/>
    <node pkg="pinky_lane_station" exec="bridge_runner" name="pinky2_bridge_down" output="screen"
          args="--from $(var station_domain) --to $(var pinky2_domain) $(var config_dir)/bridge_pinky2_down.yaml"/>
</launch>
