<?xml version="1.0"?>
<!--
  domain_bridge 2 프로세스: 기존 bridge_fleet.yaml(state/command/plan) + bridge_lane.yaml(영상·차선).
  영상 스트림이 명령 큐를 밀어내지 않도록 프로세스를 나눈다.
    sudo apt install ros-jazzy-domain-bridge
  관제 PC 에 pinky_fleet_msgs · pinky_lane_msgs 가 빌드/소싱되어 있어야 한다.
-->
<launch>
    <arg name="fleet_bridge_config"
         default="$(find-pkg-share pinky_fleet_station)/config/bridge_fleet.yaml"/>
    <arg name="lane_bridge_config"
         default="$(find-pkg-share pinky_lane_station)/config/bridge_lane.yaml"/>

    <node pkg="domain_bridge" exec="domain_bridge" name="pinky_fleet_bridge"
          args="$(var fleet_bridge_config)" output="screen"/>
    <node pkg="domain_bridge" exec="domain_bridge" name="pinky_lane_bridge"
          args="$(var lane_bridge_config)" output="screen"/>
</launch>
