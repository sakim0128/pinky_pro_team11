<?xml version="1.0"?>
<!--
  2단계: 이미 떠 있는 가제보에 로봇 1대를 올린다 (Nav2 없음).

    ros2 launch pinky_fleet_sim gz_spawn.launch.xml namespace:=pinky1 x:=-0.35 y:=1.0

  upstream 의 launch_sim.launch.xml 은 가제보 서버와 GUI 까지 자기가 띄워서 두 번
  실행할 수 없다. 그래서 스폰 부분만 떼어 왔다. upstream 파일은 손대지 않는다.

  브리지 노드는 **네임스페이스 밖에서** 띄우고 yaml 에 절대 토픽을 적었다. 브리지가
  gz 쪽 이름에도 네임스페이스를 붙이는지가 버전을 타기 때문이다.
-->
<launch>
    <arg name="namespace" default="pinky1"/>
    <arg name="x" default="0.0"/>
    <arg name="y" default="0.0"/>
    <arg name="yaw" default="0.0"/>
    <arg name="cam_tilt_deg" default="0"/>
    <arg name="bridge_params"
         default="$(find-pkg-share pinky_fleet_sim)/params/$(var namespace)_bridge.yaml"/>

    <!--
      robot_state_publisher + joint_state_publisher 를 네임스페이스 안에 띄우고,
      frame_prefix 로 TF 프레임에 접두사를 붙인다 (pinky1/base_footprint).
      이게 있어서 두 로봇의 TF 가 안 겹친다.
    -->
    <include file="$(find-pkg-share pinky_description)/launch/upload_robot.launch.py">
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="use_sim_time" value="True"/>
        <arg name="is_sim" value="True"/>
        <arg name="cam_tilt_deg" value="$(var cam_tilt_deg)"/>
    </include>

    <node pkg="ros_gz_sim" exec="create" name="spawn_$(var namespace)" output="screen"
          args="-name $(var namespace)
                -topic /$(var namespace)/robot_description
                -x $(var x) -y $(var y) -z 0.05 -Y $(var yaw)">
        <param name="use_sim_time" value="True"/>
    </node>

    <node pkg="ros_gz_bridge" exec="parameter_bridge"
          name="bridge_$(var namespace)" output="screen"
          args="--ros-args -p config_file:=$(var bridge_params)">
        <param name="use_sim_time" value="True"/>
    </node>
</launch>
