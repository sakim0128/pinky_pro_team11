# =============================================================================
# 🛰️ 함대 전역 도메인 배치표 (단일 진실 공급원)
# 이 파일을 source 하면 모든 스크립트가 동일한 도메인 값을 참조한다.
# 상세 설계: docs/DOMAIN_ARCHITECTURE.md
# =============================================================================

# ── 관제 평면 (중계 노트북 전용, 방화벽으로 외부 차단) ─────────────────────
RELAY_DOMAIN_ID=8
RELAY_IP="198.51.100.3"
RELAY_IFACE="enx001122334455"

# ── 팀원 읽기 전용 미러 (브릿지가 8 → 9 로 단방향 공급) ────────────────────
TEAM_DOMAIN_ID=9
# 연산 평면 (GPU 노트북, 2026-09-17 승인 — docs/DESIGN_20260917_COMPUTE_PLANE.md).
# ⚠️ 정의만 — 읽는 코드 0 (gateway_web_server.py 의 키 튜플·diagnostics 미포함), pinkyN_compute.yaml·compute_station/·시험 0.
#    소비처가 생기기 전까지 이 두 값은 어떤 동작도 바꾸지 않는다. IP 는 실측(M-G3) 뒤 채운다.
# 로봇 이름은 pinkyN 하나다(2026-09-29) — 도메인 변수도 PINKYN_* (게이트웨이 read_fleet_domains 가 읽는다).
COMPUTE_DOMAIN_ID=7
COMPUTE_IP=""
TEAM_IP_RANGE="198.51.100.10-198.51.100.50"
# 팀원 고정 IP(.11~.18)는 team_workspace/members.tsv 에서 배정한다.
# 공유기(ipTIME) DHCP 동적 풀은 .20~.50 이므로 고정 대역과 겹치지 않는다.
TEAM_STATIC_RANGE="198.51.100.10-198.51.100.19"
DHCP_POOL_RANGE="198.51.100.20-198.51.100.50"

# ── 로봇 고유 도메인 ────────────────────────────────────────────────────────
PINKY1_DOMAIN_ID=10
PINKY2_DOMAIN_ID=11
PINKY3_DOMAIN_ID=12
PINKY4_DOMAIN_ID=13

PINKY1_IP="198.51.100.5"
PINKY2_IP="198.51.100.6"
PINKY3_IP="198.51.100.8"
PINKY4_IP="198.51.100.9"

# ── 팀원 개인 실습(시뮬레이션) 도메인 풀 ───────────────────────────────────
# 팀원별로 하나씩 배정. 실물 로봇망(10~13)과 관제망(8)에 절대 닿지 않는다.
PERSONAL_SIM_DOMAIN_MIN=41
PERSONAL_SIM_DOMAIN_MAX=49

# ── RTPS 포트 계산식: 7400 + 250 * 도메인ID ~ +249 ─────────────────────────
dds_port_range() { echo "$((7400 + 250 * $1)):$((7400 + 250 * $1 + 249))"; }
