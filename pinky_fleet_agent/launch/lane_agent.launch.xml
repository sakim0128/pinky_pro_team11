<?xml version="1.0"?>
<!-- 차선 주행 에이전트 + 카메라만 띄운다. bringup / localization 이 이미 떠 있을 때. -->
<launch>
    <arg name="robot_name" default="pinky1"/>
    <arg name="domain_id" default="10"/>
    <arg name="params_file" default="$(find-pkg-share pinky_fleet_agent)/params/lane_agent.yaml"/>
    <arg name="use_sim_time" default="False"/>
    <arg name="use_camera" default="True"/>
    <arg name="camera_orient" default="rot180"
         description="거꾸로 장착된 카메라 보정. tools/record_drive.py --snap 으로 확정 (none|rot180|rot180_mirror|vflip|hflip)"/>
    <arg name="camera_fps" default="10.0"/>
    <arg name="jpeg_quality" default="70"/>
    <arg name="use_ultrasonic" default="True"
         description="pinky_sensor_adc main_node 의 us_sensor/range 를 장애물 감지에 쓴다"/>
    <arg name="initial_pose_on_start" default="False"
         description="로봇을 지정 초기 위치에 물리 배치한 경우에만 True. AMCL 준비 후 /initialpose를 1회 발행한다."/>
    <arg name="initial_pose_delay_sec" default="5.0"/>
    <arg name="initial_pose_x" default="0.11"/>
    <arg name="initial_pose_y" default="1.08"/>
    <arg name="initial_pose_yaw" default="0.0"/>

    <node pkg="pinky_fleet_agent" exec="lane_agent_node" name="pinky_lane_agent" output="screen">
        <param from="$(var params_file)"/>
        <param name="robot_name" value="$(var robot_name)"/>
        <param name="domain_id" value="$(var domain_id)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="use_ultrasonic" value="$(var use_ultrasonic)"/>
        <param name="initial_pose_on_start" value="$(var initial_pose_on_start)"/>
        <param name="initial_pose_delay_sec" value="$(var initial_pose_delay_sec)"/>
        <param name="initial_pose_x" value="$(var initial_pose_x)"/>
        <param name="initial_pose_y" value="$(var initial_pose_y)"/>
        <param name="initial_pose_yaw" value="$(var initial_pose_yaw)"/>
    </node>

    <!-- 카메라가 다른 프로세스에 잡혀 있으면 init 이 실패한다. 3 초 뒤 자동 재시도 -->
    <node pkg="pinky_fleet_agent" exec="camera_node" name="pinky_camera" output="screen"
          respawn="true" respawn_delay="3.0"
          if="$(var use_camera)">
        <param name="robot_name" value="$(var robot_name)"/>
        <param name="orient" value="$(var camera_orient)"/>
        <param name="fps" value="$(var camera_fps)"/>
        <param name="jpeg_quality" value="$(var jpeg_quality)"/>
    </node>
</launch>
