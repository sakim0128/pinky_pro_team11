<?xml version="1.0"?>
<!--
  로봇 1대에서 실행하는 최상위 launch.

    export ROS_DOMAIN_ID=10
    ros2 launch pinky_fleet_agent robot.launch.xml robot_name:=pinky1 domain_id:=10

  bringup(모터/라이다/TF) + Nav2 + 관제 에이전트를 한 번에 띄운다.
  로봇마다 도메인이 분리되어 있으므로 namespace 는 쓰지 않는다.

  맵은 map_dir/<map_name>.yaml (기본 /home/pinky/map/pinklab.yaml) 을 쓴다.
  관제 PC GUI 에서 맵을 고르면 "이름" 만 전달되고, 이 디렉터리에서 같은 이름을 찾아
  map_server/load_map 으로 교체한다. 그래서 두 로봇의 맵 디렉터리 구성이 같아야 한다.
-->
<launch>
    <arg name="robot_name" default="pinky1"/>
    <arg name="domain_id" default="10"/>
    <arg name="map_dir" default="/home/pinky/map"
         description="이 로봇의 맵 디렉터리. 관제 PC 는 이름만 보내고 여기서 찾는다."/>
    <arg name="map_name" default="pinklab"
         description="기동 시 로드할 맵 이름 (확장자 없음)."/>
    <arg name="map" default="$(var map_dir)/$(var map_name).yaml"
         description="맵 yaml 전체 경로. 보통은 map_dir/map_name 조합을 그대로 쓴다."/>
    <arg name="params_file"
         default="$(find-pkg-share pinky_fleet_agent)/params/nav2_params_fleet.yaml"/>
    <arg name="use_sim_time" default="False"/>
    <arg name="max_linear_vel" default="0.2"/>
    <arg name="max_angular_vel" default="1.5"/>
    <arg name="hold_watchdog" default="20.0"
         description="양보가 이만큼(s) 이어지면 목표를 버리고 대기 상태로 돌아간다."/>
    <arg name="command_timeout" default="3.0"
         description="관제 PC 하트비트가 이만큼(s) 끊기면 로봇이 스스로 주행을 멈춘다."/>
    <arg name="restore_grace" default="1.0"
         description="연결 복구 직후 이만큼(s) 이동 명령을 무시한다 (재전송 방어)."/>
    <arg name="launch_bringup" default="True"
         description="시뮬레이션에서 돌릴 때는 False 로 두고 pinky_gz_sim 을 따로 띄운다."/>

    <include file="$(find-pkg-share pinky_bringup)/launch/bringup_robot.launch.xml"
             if="$(var launch_bringup)">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share pinky_navigation)/launch/bringup_launch.xml">
        <arg name="map" value="$(var map)"/>
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <!--
          bringup_launch.xml 의 lifecycle_nodes_nav 기본값에는 smoother_server 가
          빠져 있어서, navigation_launch.xml 이 띄운 smoother_server 가 unconfigured
          상태로 방치된다. 여기서 명시적으로 넣어 준다.
        -->
        <arg name="lifecycle_nodes_nav" value="['controller_server',
                           'smoother_server',
                           'planner_server',
                           'behavior_server',
                           'bt_navigator',
                           'waypoint_follower',
                           'velocity_smoother']"/>
    </include>

    <include file="$(find-pkg-share pinky_fleet_agent)/launch/agent.launch.xml">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="domain_id" value="$(var domain_id)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="max_linear_vel" value="$(var max_linear_vel)"/>
        <arg name="max_angular_vel" value="$(var max_angular_vel)"/>
        <arg name="hold_watchdog" value="$(var hold_watchdog)"/>
        <arg name="command_timeout" value="$(var command_timeout)"/>
        <arg name="restore_grace" value="$(var restore_grace)"/>
        <arg name="map_dir" value="$(var map_dir)"/>
        <arg name="map_name" value="$(var map_name)"/>
    </include>
</launch>
