<?xml version="1.0"?>
<!--
  차선 주행 모드 로봇 최상위 launch (mini_project_2).

    export ROS_DOMAIN_ID=10
    ros2 launch pinky_fleet_agent lane_robot.launch.xml robot_name:=pinky1 domain_id:=10 \
        map:=$HOME/map/map5.yaml camera_orient:=rot180

  bringup(모터/라이다/TF) + 위치추정 + 초음파 노드 + 카메라 + lane_agent. /cmd_vel 발행자는 lane_agent 하나뿐이다.
  robot.launch.xml(Nav2 전체) 과 동시에 띄우지 말 것.

  위치추정 (둘 다 False 면 외부에서 map→odom TF 를 줘야 한다)
    use_overhead:=True (기본)  관제 overhead_tracker_node 의 /<robot>/overhead_pose 를 pose_fuser_node 가 받아 map→odom TF
    use_amcl:=True             map_server + AMCL (localization_launch). use_overhead 와 동시에 켜지 말 것
-->
<launch>
    <arg name="robot_name" default="pinky1"/>
    <arg name="domain_id" default="10"/>
    <arg name="map" default="/home/pinky/map/map5.yaml"/>
    <arg name="use_sim_time" default="False"/>
    <arg name="launch_bringup" default="True"/>
    <arg name="use_overhead" default="True" description="항공뷰 pose_fuser_node 로 map→odom TF"/>
    <arg name="use_amcl" default="False" description="map_server + AMCL. use_overhead 와 동시에 켜지 말 것"/>
    <arg name="station_latency" default="0.15" description="항공뷰 캡처→로봇 도착 지연 (s)"/>
    <arg name="marker_yaw_offset" default="0.0" description="마커 +x 가 로봇 전방과 이루는 각 (rad)"/>
    <arg name="marker_offset_x" default="0.0" description="마커 중심의 전방 오프셋 (m)"/>
    <arg name="launch_ultrasonic" default="True"
         description="pinky_sensor_adc main_node (us_sensor/range). bringup 이 띄우지 않는다."/>
    <arg name="use_camera" default="True"/>
    <arg name="camera_orient" default="rot180"/>
    <arg name="camera_fps" default="10.0"/>
    <arg name="jpeg_quality" default="70"/>
    <arg name="record" default="False" description="True: ros2 bag 블랙박스 기록 (scripts/record_bag.sh)"/>
    <arg name="log_root" default="$(env HOME)/pinky_logs"/>
    <arg name="params_file" default="$(find-pkg-share pinky_fleet_agent)/params/lane_agent.yaml"/>
    <arg name="initial_pose_on_start" default="False"/>
    <arg name="initial_pose_delay_sec" default="5.0"/>
    <arg name="initial_pose_x" default="0.11"/>
    <arg name="initial_pose_y" default="1.08"/>
    <arg name="initial_pose_yaw" default="0.0"/>

    <include file="$(find-pkg-share pinky_bringup)/launch/bringup_robot.launch.xml"
             if="$(var launch_bringup)">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <include file="$(find-pkg-share pinky_navigation)/launch/localization_launch.xml"
             if="$(var use_amcl)">
        <arg name="map" value="$(var map)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <node pkg="pinky_fleet_agent" exec="pose_fuser_node" name="pose_fuser" output="screen"
          if="$(var use_overhead)">
        <param name="robot_name" value="$(var robot_name)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="station_latency" value="$(var station_latency)"/>
        <param name="yaw_offset" value="$(var marker_yaw_offset)"/>
        <param name="offset_x" value="$(var marker_offset_x)"/>
    </node>

    <node pkg="pinky_sensor_adc" exec="main_node" name="pinky_sensor_adc" output="screen"
          if="$(var launch_ultrasonic)"/>

    <include file="$(find-pkg-share pinky_fleet_agent)/launch/lane_agent.launch.xml">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="domain_id" value="$(var domain_id)"/>
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="use_camera" value="$(var use_camera)"/>
        <arg name="camera_orient" value="$(var camera_orient)"/>
        <arg name="camera_fps" value="$(var camera_fps)"/>
        <arg name="jpeg_quality" value="$(var jpeg_quality)"/>
        <arg name="use_ultrasonic" value="$(var launch_ultrasonic)"/>
        <arg name="initial_pose_on_start" value="$(var initial_pose_on_start)"/>
        <arg name="initial_pose_delay_sec" value="$(var initial_pose_delay_sec)"/>
        <arg name="initial_pose_x" value="$(var initial_pose_x)"/>
        <arg name="initial_pose_y" value="$(var initial_pose_y)"/>
        <arg name="initial_pose_yaw" value="$(var initial_pose_yaw)"/>
    </include>

    <!-- 블랙박스: record:=True 면 ros2 bag 을 같이 띄운다 (~/pinky_logs/<날짜>/...). scripts/record_bag.sh -->
    <executable cmd="bash $(find-pkg-share pinky_fleet_agent)/scripts/record_bag.sh robot $(var robot_name) $(var log_root)"
                output="screen" if="$(var record)"/>
</launch>
